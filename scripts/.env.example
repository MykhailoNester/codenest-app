# Environment variables for build/sign/notarize and runtime.
# Copy to scripts/.env (gitignored) and fill in values when needed.

# --- Apple codesigning + notarization (Phase 5; deferred until Developer ID acquired) ---
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
APPLE_SIGNING_IDENTITY=

# --- Runtime overrides (Phase 1+) ---
# Select the database environment. Resolves to a file in app/config.py:
#   demo (dev default) -> data/codenest.demo.db   (synthetic, safe to wipe)
#   prod               -> data/codenest.db        (real data; dev opt-in)
#   prod + packaged    -> ~/Library/Application Support/com.codenest.dashboard/codenest.db
# Seed the demo DB with: python scripts/seed_demo.py  (or --reset)
CODENEST_ENV=

# Explicit absolute override; wins over CODENEST_ENV. Mainly for tests/CI.
CODENEST_DB_PATH=
