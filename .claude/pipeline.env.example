# Codenest /ship pipeline — local configuration.
#
# Copy to .claude/pipeline.env (gitignored) and edit. Nothing here is required:
# with no config file at all the pipeline derives the repo root from git, puts
# worktrees beside it, bases branches on develop, and takes its tasks from the
# prompt. This file exists so machine-specific paths never reach the repository.
#
# Read by the constants block near the top of .claude/commands/ship.md.

# Where per-task worktrees and artifacts live. Must be OUTSIDE the repo so they
# never need gitignoring and a preserved failure is easy to find.
# Default: <parent of repo>/.codenest-worktrees
CODENEST_WORKTREE_ROOT=""

# Branch every independent task is cut from.
CODENEST_BASE_BRANCH="develop"

# Branch name prefixes. The prefix is chosen per task by the kind of work.
CODENEST_PREFIX_FEATURE="feature/"
CODENEST_PREFIX_FIX="fix/"
CODENEST_PREFIX_CHORE="chore/"

# Optional roadmap document. Absolute path to a markdown file whose rows describe
# planned work. When set, Stage 0 matches requested tasks to its rows and skips
# anything already marked done; Stage 9 writes the status back after a successful
# commit. Leave empty — the normal case for this repo — and tasks come purely from
# the prompt with both stages skipped.
CODENEST_PLAN_DOC=""

# What Stage 9 writes back for a task that committed: "wip" | "done" | "off".
# Keep "wip": the work sits on an unmerged local branch, so "done" is the human's
# to set on merge. "off" disables write-back while keeping the document readable.
CODENEST_PLAN_DOC_WRITEBACK="wip"

# Add the Signed-off-by (DCO) trailer that CONTRIBUTING.md requires, via
# `git commit -s`. Set to "0" to commit without it.
CODENEST_COMMIT_SIGNOFF="1"

# Round limits. Each is a hard ceiling: hitting it fails the task rather than
# proceeding on a plan, a blocker, or a red gate.
CODENEST_MAX_PLAN_REVISIONS="2"
CODENEST_MAX_REVIEW_FIXES="2"
CODENEST_MAX_GATE_FIXES="2"
